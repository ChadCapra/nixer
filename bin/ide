#!/usr/bin/env bash

# Usage: ide <name_or_path>
# Example: ide speakless       -> resolves to ~/dev/speakless
# Example: ide ~/nixer         -> resolves to ~/nixer
# Example: ide .               -> resolves to current dir

TARGET=$1

if [ -z "$TARGET" ]; then
    echo "Usage: ide <project_name_or_path>"
    exit 1
fi

# 1. RESOLVE PATH LOGIC
# Case A: User provided a valid path (e.g. ".", "~/nixer", "/tmp/foo")
if [ -d "$TARGET" ]; then
    # Convert to absolute path
    PROJECT_PATH=$(cd "$TARGET" && pwd)

# Case B: User provided just a name (e.g. "speakless") -> Check ~/dev
elif [ -d "$HOME/dev/$TARGET" ]; then
    PROJECT_PATH="$HOME/dev/$TARGET"

else
    echo "❌ Project not found: $TARGET"
    echo "   Checked: $TARGET"
    echo "   Checked: ~/dev/$TARGET"
    exit 1
fi

# Clean name: /home/chad/dev/speakless -> speakless
PROJECT_NAME=$(basename "$PROJECT_PATH" | tr . _)

# 2. SESSION CHECK (Attach if exists)
if tmux has-session -t "$PROJECT_NAME" 2>/dev/null; then
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$PROJECT_NAME"
    else
        tmux attach -t "$PROJECT_NAME"
    fi
    exit 0
fi

# 3. CREATE SESSION (Detached)
tmux new-session -d -s "$PROJECT_NAME" -c "$PROJECT_PATH"

# 4. SETUP LAYOUT
# Check for Protocol Zero Structure (Core + UI)
if [ -d "$PROJECT_PATH/core" ] && [ -d "$PROJECT_PATH/ui" ]; then
    
    # WINDOW 1: EDITOR
    tmux rename-window -t "$PROJECT_NAME:1" "code"
    tmux send-keys -t "$PROJECT_NAME:1" "nvim ." C-m

    # WINDOW 2: SERVICES (The Protocol Zero Cockpit)
    tmux new-window -t "$PROJECT_NAME:2" -n "services" -c "$PROJECT_PATH"
    
    # Split Pane 1 (Left): Core
    tmux send-keys -t "$PROJECT_NAME:2" "cd core && direnv allow && just dev" C-m
    
    # Split Pane 2 (Right Top): UI
    tmux split-window -h -t "$PROJECT_NAME:2" -c "$PROJECT_PATH"
    tmux send-keys -t "$PROJECT_NAME:2.2" "cd ui && direnv allow && just dev" C-m
    
    # Split Pane 3 (Right Bottom): Database
    tmux split-window -v -t "$PROJECT_NAME:2.2" -c "$PROJECT_PATH"
    tmux send-keys -t "$PROJECT_NAME:2.3" "cd core && direnv allow && just db" C-m

    # WINDOW 3: SHELL (Git/Ops)
    tmux new-window -t "$PROJECT_NAME:3" -n "shell" -c "$PROJECT_PATH"

    # WINDOW 4: CONSOLE (IEx/DB Access)
    tmux new-window -t "$PROJECT_NAME:4" -n "console" -c "$PROJECT_PATH/core"
    tmux send-keys -t "$PROJECT_NAME:4" "iex -S mix" C-m

else
    # GENERIC PROJECT
    tmux rename-window -t "$PROJECT_NAME:1" "editor"
    tmux send-keys -t "$PROJECT_NAME:1" "nvim ." C-m
    
    tmux new-window -t "$PROJECT_NAME:2" -n "shell" -c "$PROJECT_PATH"
fi

# 5. ATTACH
tmux select-window -t "$PROJECT_NAME:1"
if [ -n "$TMUX" ]; then
    tmux switch-client -t "$PROJECT_NAME"
else
    tmux attach -t "$PROJECT_NAME"
fi
