#!/usr/bin/env bash

# 1. Select the Project
SESSION_NAME=$1
if [[ -z "$SESSION_NAME" ]]; then
    # "Launcher Mode"
    # Logic:
    # 1. Find all subdirectories inside ~/dev (your projects)
    # 2. Manually echo ~/nixer (your config) so it appears as one solid entry
    # 3. Pipe everything to fzf
    SESSION_NAME=$({ find ~/dev -mindepth 1 -maxdepth 1 -type d 2>/dev/null; echo "$HOME/nixer"; } | fzf --header "Select a Tmux Session (Ctrl-C to Cancel)")
fi

if [[ -z "$SESSION_NAME" ]]; then
    exit 0
fi

# Clean up the name (path -> name)
# e.g. /home/capsc/nixer -> nixer
# e.g. /home/capsc/dev/svg_dsl -> svg_dsl
NAME=$(basename "$SESSION_NAME" | tr . _)

# 2. Create Session (If it doesn't exist)
if ! tmux has-session -t="$NAME" 2> /dev/null; then
    tmux new-session -ds "$NAME" -c "$SESSION_NAME"
    
    # ----------------------------------------------------------
    # 3. LAYOUT DEFINITIONS
    # ----------------------------------------------------------
    case "$NAME" in
        "nixer")
            tmux rename-window -t "$NAME:1" "editor"
            tmux send-keys -t "$NAME:1" "nvim" C-m
            tmux new-window -t "$NAME" -n "system" -c "$SESSION_NAME"
            tmux select-window -t "$NAME:1"
            ;;
        
        "svg_dsl") 
            # Note: 'svg_dsl' must match the folder name (underscores vs hyphens matter!)
            tmux rename-window -t "$NAME:1" "dev"
            tmux send-keys -t "$NAME:1" "nvim" C-m
            tmux split-window -v -l 20% -c "$SESSION_NAME"
            tmux select-pane -t 0
            ;;
            
        *)
            tmux rename-window -t "$NAME:1" "editor"
            tmux send-keys -t "$NAME:1" "nvim" C-m
            tmux new-window -t "$NAME" -n "shell" -c "$SESSION_NAME"
            tmux select-window -t "$NAME:1"
            ;;
    esac
fi

# 4. Attach
if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$NAME"
else
    tmux attach-session -t "$NAME"
fi
