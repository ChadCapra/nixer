#!/usr/bin/env bash

# 1. Select the Project
# If argument provided, use it. Otherwise, search ~/dev and ~/nixer config
if [[ $# -eq 1 ]]; then
    SELECTED=$1
else
    SELECTED=$(find ~/dev -mindepth 1 -maxdepth 1 -type d 2>/dev/null; echo "$HOME/nixer")
    SELECTED=$(echo "$SELECTED" | fzf --header "Select Project (Ctrl-C to Cancel)")
fi

if [[ -z "$SELECTED" ]]; then
    exit 0
fi

# 2. Hand off to the Engine
ide "$SELECTED"
