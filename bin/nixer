#!/usr/bin/env bash

# ==============================================================================
# THE NIXER SYSTEM CLI
# ==============================================================================

FLAKE_DIR="$HOME/nixer"

C_RESET='\033[0m'
C_INFO='\033[1;34m'
C_SUCCESS='\033[1;32m'
C_WARN='\033[1;33m'
C_PROMPT='\033[1;35m'

log_info() { echo -e "${C_INFO}==>${C_RESET} $1"; }
log_success() { echo -e "${C_SUCCESS}==>${C_RESET} $1"; }
log_warn() { echo -e "${C_WARN}==>${C_RESET} $1"; }
log_step() { echo -e "\n${C_INFO}--- $1 ---${C_RESET}"; }

is_nixos() { [ -f "/etc/NIXOS" ]; }

# ==============================================================================
# TARGET RESOLUTION (Dynamic Menu & Persistence)
# ==============================================================================
if [ -f "$HOME/.nixer_host" ]; then
    CURRENT_HOST=$(cat "$HOME/.nixer_host")
else
    echo -e "${C_WARN}==> Device Identification Required${C_RESET}"
    echo "It looks like this is a new installation. Please select the hardware profile for this machine:"
    echo ""

    # Dynamically read the device files to build the menu
    shopt -s nullglob
    DEVICE_FILES=("$FLAKE_DIR"/devices/*.nix)
    DEVICES=()
    for f in "${DEVICE_FILES[@]}"; do
        filename=$(basename "$f" .nix)
        DEVICES+=("$filename")
    done
    shopt -u nullglob

    if [ ${#DEVICES[@]} -eq 0 ]; then
        log_warn "No device files found in $FLAKE_DIR/devices/"
        exit 1
    fi

    # Create the interactive menu
    PS3=$'\n'"Select a device (enter the number): "
    select CURRENT_HOST in "${DEVICES[@]}"; do
        if [ -n "$CURRENT_HOST" ]; then
            echo "$CURRENT_HOST" > "$HOME/.nixer_host"
            echo ""
            log_success "Device permanently linked to: $CURRENT_HOST"
            break
        else
            echo "Invalid selection. Please enter a valid number."
        fi
    done
fi

TARGET="${USER}@${CURRENT_HOST}"

# ==============================================================================
# ENVIRONMENT VALIDATION (Runs before Setup & Rebuild)
# ==============================================================================
verify_environment() {
    local current_user="$USER"
    local user_file="$FLAKE_DIR/users/${current_user}.nix"
    local device_file="$FLAKE_DIR/devices/${CURRENT_HOST}.nix"

    echo -e "${C_INFO}==> Target Environment Detected${C_RESET}"
    echo -e "    User:     ${C_PROMPT}$current_user${C_RESET}"
    echo -e "    Hostname: ${C_PROMPT}$CURRENT_HOST${C_RESET}"
    echo ""
    
    # 1. Explicitly check for the User file
    if [ ! -f "$user_file" ]; then
        echo -e "${C_WARN}==> FATAL ERROR: User configuration not found!${C_RESET}"
        echo -e "    Expected file: ${C_SUCCESS}users/${current_user}.nix${C_RESET}"
        echo -e "    Please create this file and ensure '$CURRENT_HOST' is in the deployments block."
        exit 1
    fi

    # 2. Explicitly check for the Device file
    if [ ! -f "$device_file" ]; then
        echo -e "${C_WARN}==> FATAL ERROR: Device configuration not found!${C_RESET}"
        echo -e "    Expected file: ${C_SUCCESS}devices/${CURRENT_HOST}.nix${C_RESET}"
        exit 1
    fi

    echo -e "${C_WARN}==> Required Configuration Files Found:${C_RESET}"
    echo -e "    1. ${C_SUCCESS}users/$current_user.nix${C_RESET} (Ensure $CURRENT_HOST is in deployments!)"
    echo -e "    2. ${C_SUCCESS}devices/$CURRENT_HOST.nix${C_RESET}"
    echo ""
    
    read -p "Proceed with deployment? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "\n${C_WARN}Deployment aborted by user.${C_RESET}"
        exit 1
    fi
}

# ==============================================================================
# COMMAND: SETUP
# ==============================================================================
cmd_setup() {
    echo -e "${C_SUCCESS}🚀 Bootstrapping The Nixer System${C_RESET}"
    verify_environment

    # --------------------------------------------------------------------------
    log_step "PHASE 1: Nix Package Manager & Connectivity"
    # --------------------------------------------------------------------------
    if ! command -v nix &> /dev/null; then
        log_warn "Nix package manager not found! Please install it first:"
        echo "sh <(curl -L https://nixos.org/nix/install) --daemon"
        exit 1
    fi
    log_success "Verified $(nix --version)"

    # 1. Enable Flakes FIRST so the info command works
    mkdir -p ~/.config/nix
    if ! grep -q "experimental-features" ~/.config/nix/nix.conf 2>/dev/null; then
        log_info "Enabling Nix Flakes..."
        echo "experimental-features = nix-command flakes" >> ~/.config/nix/nix.conf
    fi

    # 2. SSL Check using the exact, validated command
    if ! nix store info --store https://cache.nixos.org &>/dev/null; then
        log_warn "Nix cache unreachable. Applying legacy SSL certificate patch..."

        nix-env -iA nixpkgs.cacert
        CERT_PATH=$(readlink -f ~/.nix-profile/etc/ssl/certs/ca-bundle.crt)

        sudo mkdir -p /etc/systemd/system/nix-daemon.service.d/
        echo -e "[Service]\nEnvironment=\"NIX_SSL_CERT_FILE=$CERT_PATH\"\nEnvironment=\"CURL_CA_BUNDLE=$CERT_PATH\"" | sudo tee /etc/systemd/system/nix-daemon.service.d/override.conf >/dev/null

        sudo systemctl daemon-reload
        sudo systemctl restart nix-daemon

        if nix store info --store https://cache.nixos.org &>/dev/null; then
            log_success "SSL Certificates bridged successfully."
        else
            log_warn "SSL patch applied, but connection still failed. Setup may halt."
        fi
    else
        log_success "Nix Daemon SSL connectivity verified."
    fi

	# --------------------------------------------------------------------------
    log_step "PHASE 2: System Compilation"
    # --------------------------------------------------------------------------
    cd "$FLAKE_DIR" || { log_warn "Repository not found at $FLAKE_DIR"; exit 1; }

    if is_nixos; then
        log_info "Detected bare-metal NixOS. Initiating rebuild for $CURRENT_HOST..."
        sudo nixos-rebuild switch --flake .#"$CURRENT_HOST"
    else
        log_info "Detected guest environment. Initiating profile switch for $TARGET..."
        
        # --- NEW CONTEXT WARNING ---
        echo ""
        log_warn "NOTE ON GPU DRIVERS: Home Manager may print a warning below asking"
        log_warn "you to manually run a /nix/store/.../non-nixos-gpu-setup script."
        log_warn "Please IGNORE this. Nixer handles it automatically in Phase 3."
        echo ""

        nix run "github:nix-community/home-manager" -- switch -b backup --flake .#"$TARGET"
    fi

    # --------------------------------------------------------------------------
    log_step "PHASE 3: Post-Install Configuration"
    # --------------------------------------------------------------------------

    # 1. Idempotent GPU Bridging (No Prompts, No State Files)
    if ! is_nixos; then
        GPU_SCRIPT=$(ls /nix/store/*-non-nixos-gpu/bin/non-nixos-gpu-setup 2>/dev/null | head -n 1)
        if [ -n "$GPU_SCRIPT" ]; then
            log_info "Declarative GPU bridge detected. Synchronizing host drivers..."
            sudo "$GPU_SCRIPT" >/dev/null 2>&1
            log_success "GPU drivers synchronized."
        fi
    fi

    # 2. Path Injection
    export PATH="$HOME/.nix-profile/bin:$HOME/nixer/bin:$PATH"

    echo ""
    log_success "Setup complete! The Nixer environment is fully active."
}

# ==============================================================================
# COMMAND: REBUILD
# ==============================================================================
cmd_rebuild() {
    verify_environment
    log_info "Rebuilding System Configuration..."
    cd "$FLAKE_DIR" || exit

    if is_nixos; then
        sudo nixos-rebuild switch --flake .#"$CURRENT_HOST"
    else
        home-manager switch -b backup --flake .#"$TARGET"
    fi
}

# ==============================================================================
# COMMAND: SWEEP & SWEEP-FULL (Targeted Store Pruning)
# ==============================================================================
cmd_sweep() {
    log_info "Executing targeted sweep (Preserving offline build capability)..."

    if is_nixos; then
        # Delete old system generations, keeping the current one
        sudo nix-env --profile /nix/var/nix/profiles/system --delete-generations old
    else
        # Delete old Home Manager generations for the active user
        nix-env --profile "$HOME/.local/state/nix/profiles/home-manager" --delete-generations old
        nix-env --profile "$HOME/.local/state/nix/profiles/profile" --delete-generations old
    fi

    # Run a shallow collect to remove unreferenced paths without killing build dependencies
    nix-store --gc --print-dead >/dev/null
    log_success "Targeted sweep complete. Dead profiles removed."
}

cmd_sweep_full() {
    log_warn "Executing full store purge (This will require internet for the next rebuild)..."

    # Deep purge of all user and root generations
    nix-collect-garbage -d >/dev/null
    
    if is_nixos; then
        sudo nix-collect-garbage -d
        sudo nix-store --optimize
    else
        sudo /nix/var/nix/profiles/default/bin/nix-collect-garbage -d
        sudo /nix/var/nix/profiles/default/bin/nix-store --optimize
    fi

    log_success "Global store optimized and completely cleared."
}

# ==============================================================================
# COMMAND: INVENTORY
# ==============================================================================
cmd_inventory() {
    log_info "Managed Packages Currently Installed:"
    if is_nixos; then
        nix-store -q --requisites /run/current-system | cut -d- -f2- | sort -u
    else
        home-manager packages | awk '{print $1}' | sort
    fi
}

# ==============================================================================
# ROUTER
# ==============================================================================
case "$1" in
    setup) cmd_setup ;;
    rebuild) cmd_rebuild ;;
    sweep) cmd_sweep ;;
    sweep-full) cmd_sweep_full ;;
    inventory) cmd_inventory ;;
    *)
        echo "Usage: nixer {setup|rebuild|sweep|sweep-full|inventory}"
        echo ""
        echo "Commands:"
        echo "  setup       Compile the system and activate profile"
        echo "  rebuild     Apply configuration changes"
        echo "  sweep       Delete old generations (Preserves offline rebuild capability)"
        echo "  sweep-full  Delete old generations AND build dependencies (Maximizes disk space)"
        echo "  inventory   List installed packages"
        exit 1
        ;;
esac
