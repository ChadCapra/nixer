#!/usr/bin/env bash

# ==============================================================================
# THE NIXER SYSTEM CLI
# ==============================================================================

TARGET="${USER}@$(hostname)"
FLAKE_DIR="$HOME/nixer"

C_RESET='\033[0m'
C_INFO='\033[1;34m'
C_SUCCESS='\033[1;32m'
C_WARN='\033[1;33m'
C_PROMPT='\033[1;35m'

log_info() { echo -e "${C_INFO}==>${C_RESET} $1"; }
log_success() { echo -e "${C_SUCCESS}==>${C_RESET} $1"; }
log_warn() { echo -e "${C_WARN}==>${C_RESET} $1"; }
log_step() { echo -e "\n${C_INFO}--- $1 ---${C_RESET}"; }

is_nixos() { [ -f "/etc/NIXOS" ]; }

# ==============================================================================
# ENGINE SYNC (Reads JSON, patches Flake)
# ==============================================================================
sync_versions() {
    if [ ! -f "$FLAKE_DIR/nixer.json" ]; then
        log_warn "nixer.json not found! Falling back to 26.05."
        NIXER_VERSION="26.05"
    else
        # Extract version strictly without external dependencies like jq
        NIXER_VERSION=$(grep '"version"' "$FLAKE_DIR/nixer.json" | cut -d'"' -f4)
    fi

    # Hot-patch the flake inputs to satisfy Nix evaluation purity
    sed -i "s/nixos-[0-9][0-9]\.[0-9][0-9]/nixos-$NIXER_VERSION/g" "$FLAKE_DIR/flake.nix"
    sed -i "s/release-[0-9][0-9]\.[0-9][0-9]/release-$NIXER_VERSION/g" "$FLAKE_DIR/flake.nix"
}

# ==============================================================================
# COMMAND: SETUP
# ==============================================================================
cmd_setup() {
    echo -e "${C_SUCCESS}🚀 Bootstrapping The Nixer System${C_RESET}"

    # --------------------------------------------------------------------------
    log_step "PHASE 1: Nix Package Manager & Connectivity"
    # --------------------------------------------------------------------------
    if ! command -v nix &> /dev/null; then
        log_warn "Nix package manager not found! Please install it first:"
        echo "sh <(curl -L https://nixos.org/nix/install) --daemon"
        exit 1
    fi
    log_success "Verified $(nix --version)"

    # 1. Enable Flakes FIRST so the info command works
    mkdir -p ~/.config/nix
    if ! grep -q "experimental-features" ~/.config/nix/nix.conf 2>/dev/null; then
        log_info "Enabling Nix Flakes..."
        echo "experimental-features = nix-command flakes" >> ~/.config/nix/nix.conf
    fi

    # 2. SSL Check using the exact, validated command
    if ! nix store info --store https://cache.nixos.org &>/dev/null; then
        log_warn "Nix cache unreachable. Applying legacy SSL certificate patch..."

        nix-env -iA nixpkgs.cacert
        CERT_PATH=$(readlink -f ~/.nix-profile/etc/ssl/certs/ca-bundle.crt)

        sudo mkdir -p /etc/systemd/system/nix-daemon.service.d/
        echo -e "[Service]\nEnvironment=\"NIX_SSL_CERT_FILE=$CERT_PATH\"\nEnvironment=\"CURL_CA_BUNDLE=$CERT_PATH\"" | sudo tee /etc/systemd/system/nix-daemon.service.d/override.conf >/dev/null

        sudo systemctl daemon-reload
        sudo systemctl restart nix-daemon

        if nix store info --store https://cache.nixos.org &>/dev/null; then
            log_success "SSL Certificates bridged successfully."
        else
            log_warn "SSL patch applied, but connection still failed. Setup may halt."
        fi
    else
        log_success "Nix Daemon SSL connectivity verified."
    fi

    # --------------------------------------------------------------------------
    log_step "PHASE 2: System Compilation"
    # --------------------------------------------------------------------------
    cd "$FLAKE_DIR" || { log_warn "Repository not found at $FLAKE_DIR"; exit 1; }

    sync_versions
    log_info "Targeting Nixer Engine v${NIXER_VERSION}"

    if is_nixos; then
        log_info "Detected bare-metal NixOS. Initiating rebuild for $(hostname)..."
        sudo nixos-rebuild switch --flake .#"$(hostname)"
    else
        log_info "Detected guest environment. Initiating profile switch for $TARGET..."
        nix run "home-manager/release-$NIXER_VERSION" -- switch --flake .#"$TARGET"
    fi

    # --------------------------------------------------------------------------
    log_step "PHASE 3: Post-Install Configuration"
    # --------------------------------------------------------------------------

    # 1. Idempotent GPU Bridging (No Prompts, No State Files)
    if ! is_nixos; then
        GPU_SCRIPT=$(ls /nix/store/*-non-nixos-gpu/bin/non-nixos-gpu-setup 2>/dev/null | head -n 1)
        if [ -n "$GPU_SCRIPT" ]; then
            log_info "Declarative GPU bridge detected. Synchronizing host drivers..."
            sudo "$GPU_SCRIPT" >/dev/null 2>&1
            log_success "GPU drivers synchronized."
        fi
    fi

    # 2. Path Injection
    export PATH="$HOME/.nix-profile/bin:$HOME/nixer/bin:$PATH"

    echo ""
    log_success "Setup complete! The Nixer environment is fully active."
}

# ==============================================================================
# COMMAND: REBUILD
# ==============================================================================
cmd_rebuild() {
    log_info "Rebuilding System Configuration..."
    cd "$FLAKE_DIR" || exit

    sync_versions
    log_info "Targeting Nixer Engine v${NIXER_VERSION}"

    if is_nixos; then
        sudo nixos-rebuild switch --flake .#"$(hostname)"
    else
        home-manager switch --flake .#"$TARGET"
    fi
}

# ==============================================================================
# COMMAND: SWEEP & INVENTORY
# ==============================================================================
cmd_sweep() {
    log_info "Sweeping Nix Garbage and Optimizing Store..."
    nix-collect-garbage -d
    if is_nixos; then
        sudo nix-collect-garbage -d && sudo nix-store --optimize
    else
        sudo /nix/var/nix/profiles/default/bin/nix-collect-garbage -d
        sudo /nix/var/nix/profiles/default/bin/nix-store --optimize
    fi
    log_success "System optimized."
}

cmd_inventory() {
    log_info "Managed Packages Currently Installed:"
    if is_nixos; then
        nix-store -q --requisites /run/current-system | cut -d- -f2- | sort -u
    else
        home-manager packages | awk '{print $1}' | sort
    fi
}

# ==============================================================================
# ROUTER
# ==============================================================================
case "$1" in
    setup) cmd_setup ;;
    rebuild) cmd_rebuild ;;
    sweep) cmd_sweep ;;
    inventory) cmd_inventory ;;
    *)
        echo "Usage: nixer {setup|rebuild|sweep|inventory}"
        exit 1
        ;;
esac
