#!/usr/bin/env bash

# 1. Boot 'nixer' (The Config Session) - BACKGROUND
# We check if it exists; if not, we create it but DO NOT attach.
if ! tmux has-session -t nixer 2>/dev/null; then
    # Create detached session in ~/nixer
    tmux new-session -d -s nixer -c ~/nixer
    
    # Window 1: Editor
    tmux rename-window -t nixer:1 "config"
    tmux send-keys -t nixer:1 "nvim ." C-m
    
    # Window 2: Rebuild (Shell)
    tmux new-window -t nixer:2 -n "rebuild" -c ~/nixer
fi

# 2. Boot 'home' (The Daily Driver) - FOREGROUND
# This is where you land.
if ! tmux has-session -t home 2>/dev/null; then
    tmux new-session -d -s home -c ~
    tmux rename-window -t home:1 "terminal"
fi

# 3. Attach to Home
if [ -z "$TMUX" ]; then
    tmux attach -t home
else
    tmux switch-client -t home
fi
